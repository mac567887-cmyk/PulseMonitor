<Application x:Class="PulseMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PulseBg" Color="#0B0F14"/>
    <SolidColorBrush x:Key="PulsePanel" Color="#141A22"/>
    <SolidColorBrush x:Key="PulseAccent" Color="#3D9CF0"/>
    <SolidColorBrush x:Key="PulseText" Color="#F0F4FA"/>
    <SolidColorBrush x:Key="PulseMuted" Color="#B4BED1"/>
  </Application.Resources>
</Application>
