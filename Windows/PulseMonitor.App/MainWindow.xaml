<Window x:Class="PulseMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseMonitor 4 · Windows"
        Width="1280" Height="840"
        Background="{StaticResource PulseBg}"
        Foreground="{StaticResource PulseText}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#10161E" Padding="12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="PulseMonitor" FontSize="20" FontWeight="SemiBold" Margin="8,8,8,16"
                   Foreground="{StaticResource PulseAccent}"/>
        <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                 Foreground="{StaticResource PulseText}"
                 SelectionChanged="NavList_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,8"/>
              <Setter Property="Margin" Value="0,2"/>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1" Padding="28" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="ContentHost" />
    </ScrollViewer>
  </Grid>
</Window>
